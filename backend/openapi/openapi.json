{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Native Online Judge API",
    "description": "Phase 3 hand-written OpenAPI document for authentication, problem browsing, submissions, run tasks, and administrator problem/test-data management.",
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local API Server"
    }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Auth" },
    { "name": "Problems" },
    { "name": "Admin" },
    { "name": "Submissions" },
    { "name": "AI" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "API Server health check",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["System"],
        "summary": "OpenAPI document",
        "responses": {
          "200": { "description": "OpenAPI JSON document" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/AuthSuccess" },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login and return a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthSuccess" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Return the authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/problems": {
      "get": {
        "tags": ["Problems"],
        "summary": "List published problems",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/DifficultyQuery" },
          { "$ref": "#/components/parameters/TagQuery" },
          { "$ref": "#/components/parameters/SearchQuery" }
        ],
        "responses": {
          "200": {
            "description": "Published problem page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProblemPageResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/problems/{id}": {
      "get": {
        "tags": ["Problems"],
        "summary": "Get a published problem detail",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Problem detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetailResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/problems": {
      "get": {
        "tags": ["Admin"],
        "summary": "List all problems for administrators",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/StatusQuery" },
          { "$ref": "#/components/parameters/SearchQuery" }
        ],
        "responses": {
          "200": { "description": "Problem page" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create a problem",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProblemWriteRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/ProblemDetail" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/problems/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get an administrator problem detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProblemDetail" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "Update a problem",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProblemWriteRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ProblemDetail" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/problems/{id}/testcases": {
      "get": {
        "tags": ["Admin"],
        "summary": "List test cases for a problem",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "Test case list" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create a test case and write input/output files",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TestCaseWriteRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Test case created" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/tags": {
      "get": {
        "tags": ["Admin"],
        "summary": "List problem tags",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Tag list" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create or return a problem tag",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 40 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Tag saved" }
        }
      }
    },
    "/api/admin/difficulties": {
      "get": {
        "tags": ["Admin"],
        "summary": "List built-in difficulties and usage counts",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Difficulty list" }
        }
      }
    },
    "/api/submissions": {
      "post": {
        "tags": ["Submissions"],
        "summary": "Create a submission",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmissionCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/SubmissionDetail" },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/submissions/{id}": {
      "get": {
        "tags": ["Submissions"],
        "summary": "Get a submission detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SubmissionDetail" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/me/submissions": {
      "get": {
        "tags": ["Submissions"],
        "summary": "List authenticated user's submissions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "description": "Submission page" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/run": {
      "post": {
        "tags": ["Submissions"],
        "summary": "Run code against samples or custom input",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/SubmissionDetail" },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/admin/submissions": {
      "get": {
        "tags": ["Admin"],
        "summary": "List all submissions for administrators",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "description": "Submission page" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/ai/hint": {
      "post": {
        "tags": ["AI"],
        "summary": "Request an AI hint",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "format": "int64", "minimum": 1 }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "DifficultyQuery": {
        "name": "difficulty",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/ProblemDifficulty" }
      },
      "StatusQuery": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/ProblemStatus" }
      },
      "TagQuery": {
        "name": "tag",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      },
      "SearchQuery": {
        "name": "q",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "AuthSuccess": {
        "description": "Authenticated session",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AuthResponse" }
          }
        }
      },
      "ProblemDetail": {
        "description": "Problem detail",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetailResponse" }
          }
        }
      },
      "SubmissionDetail": {
        "description": "Submission detail",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SubmissionDetailResponse" }
          }
        }
      },
      "Error": {
        "description": "Uniform API error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiResponse" }
          }
        }
      },
      "NotImplemented": {
        "description": "Endpoint reserved for later phases",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiResponse" },
            "example": {
              "code": "NOT_IMPLEMENTED",
              "message": "Endpoint will be implemented in a later phase",
              "data": {},
              "request_id": "req_1"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["code", "message", "data", "request_id"],
        "properties": {
          "code": { "type": "string", "example": "OK" },
          "message": { "type": "string", "example": "success" },
          "data": { "type": "object" },
          "request_id": { "type": "string", "example": "req_1" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 32 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8, "maxLength": 128 }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["login", "password"],
        "properties": {
          "login": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "AuthResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponse" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "required": ["token", "user"],
                "properties": {
                  "token": { "type": "string" },
                  "user": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        ]
      },
      "User": {
        "type": "object",
        "required": ["id", "username", "email", "role"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "ProblemDifficulty": {
        "type": "string",
        "enum": ["easy", "medium", "hard"]
      },
      "ProblemStatus": {
        "type": "string",
        "enum": ["draft", "published", "archived"]
      },
      "ProblemSummary": {
        "type": "object",
        "required": ["id", "title", "difficulty", "tags", "status"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "title": { "type": "string" },
          "difficulty": { "$ref": "#/components/schemas/ProblemDifficulty" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "accepted_count": { "type": "integer", "format": "int64" },
          "submission_count": { "type": "integer", "format": "int64" },
          "acceptance_rate": { "type": "number" },
          "status": { "$ref": "#/components/schemas/ProblemStatus" }
        }
      },
      "ProblemDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/ProblemSummary" },
          {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "time_limit_ms": { "type": "integer" },
              "memory_limit_mb": { "type": "integer" },
              "default_code_template": { "type": "string" },
              "source": { "type": "string" },
              "test_cases": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/TestCase" }
              }
            }
          }
        ]
      },
      "ProblemWriteRequest": {
        "type": "object",
        "required": ["title", "description", "difficulty", "status"],
        "properties": {
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string" },
          "difficulty": { "$ref": "#/components/schemas/ProblemDifficulty" },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
          "time_limit_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
          "memory_limit_mb": { "type": "integer", "minimum": 16, "maximum": 4096 },
          "default_code_template": { "type": "string" },
          "source": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ProblemStatus" }
        }
      },
      "TestCase": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "problem_id": { "type": "integer", "format": "int64" },
          "kind": { "type": "string", "enum": ["sample", "public", "hidden"] },
          "input_summary": { "type": "string" },
          "output_summary": { "type": "string" },
          "display_full_content": { "type": "boolean" },
          "sort_order": { "type": "integer" },
          "input": { "type": "string" },
          "output": { "type": "string" }
        }
      },
      "TestCaseWriteRequest": {
        "type": "object",
        "required": ["kind", "input", "output"],
        "properties": {
          "kind": { "type": "string", "enum": ["sample", "public", "hidden"] },
          "input": { "type": "string", "maxLength": 1048576 },
          "output": { "type": "string", "maxLength": 1048576 },
          "input_summary": { "type": "string" },
          "output_summary": { "type": "string" },
          "display_full_content": { "type": "boolean" },
          "sort_order": { "type": "integer", "minimum": 0 }
        }
      },
      "SubmissionStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Judging",
          "Accepted",
          "Wrong Answer",
          "Time Limit Exceeded",
          "Memory Limit Exceeded",
          "Runtime Error",
          "Compilation Error",
          "System Error"
        ]
      },
      "SubmissionCreateRequest": {
        "type": "object",
        "required": ["problem_id", "source_code"],
        "properties": {
          "problem_id": { "type": "integer", "format": "int64" },
          "language": { "type": "string", "enum": ["cpp17"], "default": "cpp17" },
          "source_code": { "type": "string", "maxLength": 262144 }
        }
      },
      "RunCreateRequest": {
        "type": "object",
        "required": ["problem_id", "source_code", "mode"],
        "properties": {
          "problem_id": { "type": "integer", "format": "int64" },
          "source_code": { "type": "string", "maxLength": 262144 },
          "mode": { "type": "string", "enum": ["samples", "custom"] },
          "custom_input": { "type": "string", "maxLength": 1048576 }
        }
      },
      "SubmissionCaseResult": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "submission_id": { "type": "integer", "format": "int64" },
          "test_case_id": { "type": "integer", "format": "int64", "nullable": true },
          "status": { "$ref": "#/components/schemas/SubmissionStatus" },
          "time_ms": { "type": "integer", "nullable": true },
          "memory_mb": { "type": "integer", "nullable": true },
          "error_summary": { "type": "string" },
          "sort_order": { "type": "integer" },
          "kind": { "type": "string" },
          "input_summary": { "type": "string" },
          "output_summary": { "type": "string" }
        }
      },
      "SubmissionDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "user_id": { "type": "integer", "format": "int64" },
          "username": { "type": "string" },
          "problem_id": { "type": "integer", "format": "int64" },
          "problem_title": { "type": "string" },
          "language": { "type": "string", "enum": ["cpp17"] },
          "source_code": { "type": "string" },
          "status": { "$ref": "#/components/schemas/SubmissionStatus" },
          "compile_error": { "type": "string", "nullable": true },
          "total_time_ms": { "type": "integer", "nullable": true },
          "peak_memory_mb": { "type": "integer", "nullable": true },
          "stdout": { "type": "string", "nullable": true },
          "stderr": { "type": "string", "nullable": true },
          "judge_message": { "type": "string", "nullable": true },
          "testcase_passed_count": { "type": "integer" },
          "testcase_total_count": { "type": "integer" },
          "case_results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SubmissionCaseResult" }
          }
        }
      },
      "ProblemPageResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponse" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/ProblemSummary" }
                  },
                  "page": { "type": "integer" },
                  "page_size": { "type": "integer" },
                  "total": { "type": "integer" }
                }
              }
            }
          }
        ]
      },
      "ProblemDetailResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponse" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/ProblemDetail" }
            }
          }
        ]
      },
      "SubmissionDetailResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponse" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/SubmissionDetail" }
            }
          }
        ]
      }
    }
  }
}
