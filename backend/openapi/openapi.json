{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Native Online Judge API",
    "description": "Phase 1 hand-written OpenAPI scaffold for the V1 Online Judge API.",
    "version": "0.1.0"
  },
  "servers": [
